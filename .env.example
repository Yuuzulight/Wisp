# Copy to .env and fill in what you need. All values shown are defaults.

SEARXNG_URL=http://127.0.0.1:8890
LLAMA_SERVER_URL=http://127.0.0.1:8090

# Only required if you use backend="claude" on a query.
ANTHROPIC_API_KEY=

WISP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WISP_EXTRACT_TOP_N=6
WISP_PRUNE_MARGIN=0.45
WISP_LOCAL_MODEL=local
WISP_CLAUDE_MODEL=claude-sonnet-5
